<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="de" datatype="plaintext" original="messages"
          date="2025-01-01T00:00:00Z" product-name="mai_consent">
        <header/>
        <body>
            <trans-unit id="mlang_tabs_tab">
                <source>Consent Statistics</source>
                <target>Einwilligungsstatistik</target>
            </trans-unit>
            <trans-unit id="mlang_labels_tablabel">
                <source>Consent Statistics</source>
                <target>Einwilligungsstatistik</target>
            </trans-unit>
            <trans-unit id="mlang_labels_tabdescr">
                <source>View cookie consent statistics and manage consent settings.</source>
                <target>Cookie-Einwilligungsstatistiken einsehen und Einwilligungseinstellungen verwalten.</target>
            </trans-unit>
            <trans-unit id="module.title">
                <source>Consent Statistics</source>
                <target>Einwilligungsstatistik</target>
            </trans-unit>
            <trans-unit id="stats.category">
                <source>Category</source>
                <target>Kategorie</target>
            </trans-unit>
            <trans-unit id="stats.total">
                <source>Total</source>
                <target>Gesamt</target>
            </trans-unit>
            <trans-unit id="stats.accepted">
                <source>Accepted</source>
                <target>Akzeptiert</target>
            </trans-unit>
            <trans-unit id="stats.rate">
                <source>Acceptance Rate</source>
                <target>Zustimmungsrate</target>
            </trans-unit>
            <trans-unit id="stats.empty">
                <source>No consent logs recorded yet.</source>
                <target>Es wurden noch keine Einwilligungen protokolliert.</target>
            </trans-unit>
            <trans-unit id="banner.text">
                <source>We use cookies and similar technologies to improve your experience. Please choose which categories you consent to.</source>
                <target>Wir verwenden Cookies und ähnliche Technologien, um Ihre Erfahrung zu verbessern. Bitte wählen Sie aus, welchen Kategorien Sie zustimmen.</target>
            </trans-unit>
            <trans-unit id="banner.acceptAll">
                <source>Accept all</source>
                <target>Alle akzeptieren</target>
            </trans-unit>
            <trans-unit id="banner.customize">
                <source>Customize</source>
                <target>Anpassen</target>
            </trans-unit>
            <trans-unit id="banner.rejectAll">
                <source>Reject all</source>
                <target>Alle ablehnen</target>
            </trans-unit>
            <trans-unit id="modal.title">
                <source>Cookie Preferences</source>
                <target>Cookie-Einstellungen</target>
            </trans-unit>
            <trans-unit id="modal.intro">
                <source>Switch each category on or off. Necessary cookies stay on.</source>
                <target>Schalte jede Kategorie einzeln an oder aus. Notwendige Cookies bleiben an.</target>
            </trans-unit>
            <trans-unit id="modal.switchOn">
                <source>On</source>
                <target>An</target>
            </trans-unit>
            <trans-unit id="modal.switchOff">
                <source>Off</source>
                <target>Aus</target>
            </trans-unit>
            <trans-unit id="modal.switchLocked">
                <source>Always on</source>
                <target>Immer an</target>
            </trans-unit>
            <trans-unit id="modal.save">
                <source>Save preferences</source>
                <target>Einstellungen speichern</target>
            </trans-unit>
            <trans-unit id="gate.video.placeholder">
                <source>This video is hosted on YouTube and stays blocked until you allow videos.</source>
                <target>Dieses Video liegt bei YouTube und wird erst geladen, wenn Sie Videos erlauben.</target>
            </trans-unit>
            <trans-unit id="gate.vimeo.placeholder">
                <source>This video is hosted on Vimeo and stays blocked until you allow videos.</source>
                <target>Dieses Video liegt bei Vimeo und wird erst geladen, wenn Sie Videos erlauben.</target>
            </trans-unit>
            <trans-unit id="gate.video.load">
                <source>Load video</source>
                <target>Video laden</target>
            </trans-unit>
            <trans-unit id="gate.map.placeholder">
                <source>This map is hosted on OpenStreetMap and stays blocked until you allow maps.</source>
                <target>Diese Karte liegt bei OpenStreetMap und wird erst geladen, wenn Sie Karten erlauben.</target>
            </trans-unit>
            <trans-unit id="gate.map.load">
                <source>Load map</source>
                <target>Karte laden</target>
            </trans-unit>
        </body>
    </file>
</xliff>
